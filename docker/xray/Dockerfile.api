FROM python:3.12-slim

WORKDIR /app

COPY api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY api/app /app

ENV XRAY_USERS_FILE=/data/users.json
ENV XRAY_SETTINGS_FILE=/data/api_settings.json
ENV XRAY_CONFIG_FILE=/data/config.json
ENV XRAY_CONTAINER_NAME=xray
ENV API_HOST=0.0.0.0
ENV API_PORT=8080

CMD ["sh", "-c", "uvicorn main:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-8080}"]
