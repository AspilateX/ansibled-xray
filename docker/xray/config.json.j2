{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": {{ xray_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% for user in xray_users %}
          {
            "id": "{{ user.id }}",
            "flow": "{{ user.flow | default('xtls-rprx-vision') }}"
          }{% if not loop.last %},{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_domain }}:443",
          "xver": 0,
          "serverNames": [
            "{{ xray_domain }}"
          ],
          "privateKey": "{{ reality_private_key }}",
          "shortIds": [
            "{{ short_id }}"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ]
}
