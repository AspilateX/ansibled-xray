{% set ns = namespace(has_vless=false, has_vmess=false) %}
{% for user in xray_users %}
{% if user.protocol is not defined or user.protocol == "vless" %}
{% set ns.has_vless = true %}
{% endif %}
{% if user.protocol is defined and user.protocol == "vmess" %}
{% set ns.has_vmess = true %}
{% endif %}
{% endfor %}
{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
{% if ns.has_vless %}
    {
      "port": {{ xray_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
{% set sep = joiner(",\n") %}
{% for user in xray_users %}
{% if user.protocol is not defined or user.protocol == "vless" %}
{{ sep() }}          {
            "id": "{{ user.id }}",
            "flow": "{{ user.flow | default('xtls-rprx-vision') }}"
          }
{% endif %}
{% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ xray_domain }}:443",
          "xver": 0,
          "serverNames": [
            "{{ xray_domain }}"
          ],
          "privateKey": "{{ reality_private_key }}",
          "shortIds": [
            "{{ short_id }}"
          ]
        }
      }
    }{% if ns.has_vmess %},{% endif %}
{% endif %}
{% if ns.has_vmess %}
    {
      "port": {{ xray_vmess_port | default(10086) }},
      "protocol": "vmess",
      "settings": {
        "clients": [
{% set sep = joiner(",\n") %}
{% for user in xray_users %}
{% if user.protocol is defined and user.protocol == "vmess" %}
{{ sep() }}          {
            "id": "{{ user.id }}",
            "alterId": 0
          }
{% endif %}
{% endfor %}
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none"
      }
    }
{% endif %}
  ],
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ]
}
